(deflocalkeys-linux
  th1 704
  th2 705
  th3 706
  th4 707
  th5 708
  th6 709
  th7 710
  th8 711
  th9 712
  th10 713
  th11 714
  th12 715
  th13 716
  th14 717
)

(defsrc
  lctl rctl lsft rsft spc k y o . = f c l p q z h i e a u d s t n r v j - , f24 apos w g m b x th1 th2 th3 th4 th5 th6 th7 th8 th9 th10 th11 th12 th13 th14 rpar
)

(defalias
  sp-default (switch ((or (input real lctl) (input real rctl))) (multi spc (layer-switch shingeta)) break () spc break)
  sp-shingeta (switch ((or (input real lctl) (input real rctl))) (multi spc (layer-switch default)) break () spc break)
  single-k (macro -)
  single-y (macro n i)
  single-o (macro h a)
  single-dot (macro ,)
  single-equal (macro t i)
  single-f (macro g u)
  single-c (macro b a)
  single-l (macro k o)
  single-p (macro g a)
  single-q (macro h i)
  single-z (macro g e)
  single-h (macro n o)
  single-i (macro t o)
  single-e (macro k a)
  single-a (macro n n)
  single-u (macro x t u)
  single-d (macro k u)
  single-s (macro u)
  single-t (macro i)
  single-n (macro s i)
  single-r (macro n a)
  single-v (macro q)
  single-j (macro s u)
  single-minus (macro m a)
  single-comma (macro k i)
  single-f24 (macro r u)
  single-apos (macro t u)
  single-w (macro t e)
  single-g (macro t a)
  single-m (macro d e)
  single-b (macro .)
  single-x (macro b u)
  th1-default (switch (lsft rsft) (unmod 9) break () (macro S-1) break)
  th2-default (switch (lsft rsft) (unmod 7) break () (macro S-7) break)
  th3-default (switch (lsft rsft) (unmod 5) break () (macro S-,) break)
  th4-default (switch (lsft rsft) (unmod 3) break () (macro [) break)
  th5-default (switch (lsft rsft) (unmod 1) break () (macro S-[) break)
  th6-default (switch (lsft rsft) (unmod 8) break () (macro S-grv) break)
  th7-default (switch (lsft rsft) (unmod 0) break () (macro S-]) break)
  th8-default (switch (lsft rsft) (unmod 2) break () (macro ]) break)
  th9-default (switch (lsft rsft) (unmod 4) break () (macro S-.) break)
  th10-default (switch (lsft rsft) (unmod 6) break () (macro S-4) break)
  th11-default (switch (lsft rsft) (macro S-1) break () (macro S-3) break)
  th12-default (switch (lsft rsft) (unmod grv) break () (macro S-2) break)
  th13-default (switch (lsft rsft) (macro S-6) break () (macro S-5) break)
  th14-default (switch (lsft rsft) (unmod bksl) break () (macro S-bksl) break)
  rpar-default (switch (lsft rsft) (unmod /) break () rpar break)
  f24-default (switch (lsft rsft) (macro S-=) break () (macro S-9) break)
)

(deflayer default
  lctl rctl lsft rsft @sp-default k y o . = f c l p q z h i e a u d s t n r v j - , @f24-default apos w g m b x @th1-default @th2-default @th3-default @th4-default @th5-default @th6-default @th7-default @th8-default @th9-default @th10-default @th11-default @th12-default @th13-default @th14-default @rpar-default
)

(deflayer shingeta
  lctl rctl lsft rsft @sp-shingeta @single-k @single-y @single-o @single-dot @single-equal @single-f @single-c @single-l @single-p @single-q @single-z @single-h @single-i @single-e @single-a @single-u @single-d @single-s @single-t @single-n @single-r @single-v @single-j @single-minus @single-comma @single-f24 @single-apos @single-w @single-g @single-m @single-b @single-x th1 th2 th3 th4 th5 th6 th7 th8 th9 th10 th11 th12 th13 th14 rpar
)

