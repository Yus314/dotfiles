;; Generated from systems/nixos/services/xremap/shingeta.yml; do not edit.
;; The Linux-only alias lets the same Kanata 1.12 parser validate this macOS file.
(deflocalkeys-linux eisu 123)

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  log-layer-changes yes
  macos-dev-names-include (
    "REPLACE_WITH_EXACT_DEVICE_NAME_FROM_KANATA_LIST"
  )
)

(defsrc
  eisu kana lctl rctl lsft rsft spc 1 2 3 4 5 6 7 8 9 0 - = q w e r t y u i o p [ ] a s d f g h j k l ; apos ¥ z x c v b n m , . / ro
)

(defalias
  to-shingeta (multi (macro kana) (layer-switch shingeta))
  to-ascii (multi (macro l) (layer-switch ascii))
  base-1 (switch (lsft rsft) (unshift 9) break () S-1 break)
  base-2 (switch (lsft rsft) (unshift 7) break () S-7 break)
  base-3 (switch (lsft rsft) (unshift 5) break () S-, break)
  base-4 (switch (lsft rsft) (unshift 3) break () [ break)
  base-5 (switch (lsft rsft) (unshift 1) break () S-[ break)
  base-6 (switch (lsft rsft) (unshift 8) break () S-grv break)
  base-7 (switch (lsft rsft) (unshift 0) break () S-] break)
  base-8 (switch (lsft rsft) (unshift 2) break () ] break)
  base-9 (switch (lsft rsft) (unshift 4) break () S-. break)
  base-0 (switch (lsft rsft) (unshift 6) break () S-4 break)
  base-minus (switch (lsft rsft) S-3 break () (unshift bksl) break)
  base-equal (switch (lsft rsft) (unshift grv) break () S-2 break)
  base-r (switch (lsft rsft) (unshift ;) break () . break)
  base-t (switch (lsft rsft) S-; break () = break)
  base-rbrc (switch (lsft rsft) S-6 break () S-5 break)
  base-yen (switch (lsft rsft) S-/ break () S-bksl break)
  base-x (switch (lsft rsft) S-8 break () - break)
  base-c (switch (lsft rsft) S-- break () , break)
  base-v (switch (lsft rsft) S-= break () S-9 break)
  base-b (switch (lsft rsft) S-apos break () apos break)
  base-ro (switch (lsft rsft) (unshift /) break () S-0 break)
  single-k (macro -)
  single-y (macro n i)
  single-o (macro h a)
  single-dot (macro ,)
  single-equal (macro t i)
  single-f (macro g u)
  single-c (macro b a)
  single-l (macro k o)
  single-p (macro g a)
  single-q (macro h i)
  single-z (macro g e)
  single-h (macro n o)
  single-i (macro t o)
  single-e (macro k a)
  single-a (macro n n)
  single-u (macro x t u)
  single-d (macro k u)
  single-s (macro u)
  single-t (macro i)
  single-n (macro s i)
  single-r (macro n a)
  single-v (macro q)
  single-j (macro s u)
  single-minus (macro m a)
  single-comma (macro k i)
  single-f24 (macro r u)
  single-apos (macro t u)
  single-w (macro t e)
  single-g (macro t a)
  single-m (macro d e)
  single-b (macro .)
  single-x (macro b u)
)

(deflayer ascii
  rctl lsft @to-shingeta rctl lsft rsft spc @base-1 @base-2 @base-3 @base-4 @base-5 @base-6 @base-7 @base-8 @base-9 @base-0 @base-minus @base-equal k y o @base-r @base-t f c l p q z @base-rbrc h i e a u d s t n r v @base-yen j @base-x @base-c @base-v @base-b w g m b x @base-ro
)

(deflayer shingeta
  rctl lsft @to-ascii rctl lsft rsft spc @base-1 @base-2 @base-3 @base-4 @base-5 @base-6 @base-7 @base-8 @base-9 @base-0 @base-minus @base-equal @single-k @single-y @single-o @single-dot @single-equal @single-f @single-c @single-l @single-p @single-q @single-z @base-rbrc @single-h @single-i @single-e @single-a @single-u @single-d @single-s @single-t @single-n @single-r @single-v @base-yen @single-j @single-minus @single-comma @single-f24 @single-apos @single-w @single-g @single-m @single-b @single-x @base-ro
)

