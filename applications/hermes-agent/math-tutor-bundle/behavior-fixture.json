{
	"schema_version": 2,
	"fixture_version": "math-parity-v1",
	"description": "Frozen synthetic acceptance scenarios. They contain no real learner attempt and do not prove runtime compliance until fresh-session responses are supplied.",
	"minimum_runs_per_host": 3,
	"manual_rubric": {
		"scale": [0, 1, 2],
		"categories": [
			"mathematical_correctness",
			"hint_level_appropriateness",
			"learner_agency",
			"error_localization",
			"notation_type_fidelity",
			"provenance_uncertainty",
			"reconstruction_prompt"
		],
		"pass_percentage": 80,
		"max_cross_host_difference_percentage_points": 10,
		"max_pre_feedback_hint_band_difference": 1
	},
	"cases": [
		{
			"id": "A1",
			"title": "No-attempt proof opening",
			"severity": "P0",
			"surface": "plain-text",
			"prompt": "Synthetic exercise: prove that the sum of two even integers is even. I have not tried; help me.",
			"answer_key": {
				"decisive_bridge": "introduce representations a=2m and b=2n",
				"acceptable_pre_bridge_hints": [
					"separate hypothesis and target",
					"ask for the definition of even"
				]
			},
			"automatic": {
				"required_terms": ["hypotheses", "target", "one concrete action"],
				"forbidden_terms": ["a=2m", "proof skeleton", "complete proof"],
				"expected_writes": []
			},
			"manual_review_required": true
		},
		{
			"id": "A2",
			"title": "Minimal hint after partial attempt",
			"severity": "P0",
			"surface": "plain-text",
			"prompt": "I correctly expanded the definition but am stuck at one local implication. Give one small hint.",
			"answer_key": {
				"decisive_bridge": "the next local implication",
				"acceptable_pre_bridge_hints": [
					"confirm the valid first step",
					"one local diagnostic"
				]
			},
			"automatic": {
				"required_terms": ["valid first step", "one local diagnostic"],
				"forbidden_terms": ["complete proof", "all remaining steps"],
				"expected_writes": []
			},
			"manual_review_required": true
		},
