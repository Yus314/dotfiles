{
	"schema_version": 1,
	"profile": "default",
	"semantic_identity": {
		"honcho_host": "hermes",
		"workspace": "hermes",
		"user_peer": "kaki",
		"ai_peer": "personal-assistant"
	},
	"shared_memory": {
		"allowed": [
			"stable cross-domain user preferences",
			"durable goals and constraints useful across profiles",
			"environment facts that reduce repeated steering"
		],
		"scope": "ordinary-only"
	},
	"host_local_state": [
		"state.db",
		"state.db-wal",
		"state.db-shm",
		"routing",
		"queues",
		"cron-runtime",
		"auth",
		".env",
		"secrets",
		"logs",
		"caches"
	],
	"session_continuity": {
		"mechanism": "existing-source-authoritative-archive",
		"implementation": "not-reimplemented-by-this-candidate",
		"sources": ["lawliet", "watari"],
		"transport_readiness": "blocked-pending-separate-device-reconciliation"
	},
	"control_plane_authority": "lawliet",
	"nodes": {
		"lawliet": {
			"system": "x86_64-linux",
			"roles": [
				"always-on-gateway",
				"scheduler",
				"control-plane-writer",
				"local-linux-executor",
				"session-archive-source"
			],
			"gateway_writer": true,
			"scheduler_writer": true,
			"control_plane_writer": true
		},
		"watari": {
			"system": "aarch64-darwin",
			"roles": [
				"first-class-local-cli",
				"local-macos-executor",
				"session-archive-source"
			],
			"gateway_writer": false,
			"scheduler_writer": false,
			"control_plane_writer": false
		}
	}
}
