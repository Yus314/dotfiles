+def _current_gateway_source_hook_kwargs(agent: Any) -> Dict[str, Any]:
+    """Project the active gateway source into non-throwing scalar hook fields.
+
+    Gateway agents can be cached across participants, so constructor-time
+    identity is not necessarily the current turn's source.  The gateway stages
+    the exact source for the duration of ``run_conversation``.  This boundary
+    deliberately fails closed: if any attribute access or scalar coercion
+    fails, no partially projected value (or exception payload) reaches plugins
+    or the caller's hook-error logger.
+    """
+    empty = {
+        "current_source_platform": "",
+        "current_source_user_id": "",
+        "current_source_chat_id": "",
+        "current_source_thread_id": "",
+        "current_source_guild_id": "",
+        "current_source_parent_chat_id": "",
+    }
+    try:
+        source = getattr(agent, "_current_gateway_source", None)
+    except Exception:
+        return {"current_source_present": True, "current_source_valid": False, **empty}
+    if source is None:
+        return {"current_source_present": False, "current_source_valid": False, **empty}
+
+    try:
+        platform = getattr(source, "platform", None)
+        platform = getattr(platform, "value", platform)
+
+        def _scalar(value: Any) -> str:
+            return "" if value is None else str(value)
+
+        projected = {
+            "current_source_platform": _scalar(platform),
+            "current_source_user_id": _scalar(getattr(source, "user_id", None)),
+            "current_source_chat_id": _scalar(getattr(source, "chat_id", None)),
+            "current_source_thread_id": _scalar(getattr(source, "thread_id", None)),
+            "current_source_guild_id": _scalar(getattr(source, "guild_id", None)),
+            "current_source_parent_chat_id": _scalar(
+                getattr(source, "parent_chat_id", None)
+            ),
+        }
+    except Exception:
+        return {"current_source_present": True, "current_source_valid": False, **empty}
+    return {"current_source_present": True, "current_source_valid": True, **projected}
+
