+def _discord_attr(value: Any, name: str) -> Any:
+    """Read an attribute from a potentially malformed discord.py object."""
+    try:
+        return getattr(value, name, None) if value is not None else None
+    except Exception:
+        return None
+
+
+_DISCORD_MAX_SNOWFLAKE = (1 << 64) - 1
+
+
+def _discord_snowflake_string(value: Any) -> Optional[str]:
+    """Return a strict canonical Discord snowflake string, or ``None``."""
+    if type(value) is int:
+        # Check the fixed-width range before str(); oversized Python integers can
+        # exceed the interpreter's integer-to-decimal conversion safety limit.
+        return str(value) if 1 <= value <= _DISCORD_MAX_SNOWFLAKE else None
+    if type(value) is not str or not 1 <= len(value) <= 20:
+        return None
+    if not "1" <= value[0] <= "9":
+        return None
+    if any(character < "0" or character > "9" for character in value[1:]):
+        return None
+    try:
+        snowflake = int(value)
+    except (ValueError, OverflowError):
+        return None
+    return value if snowflake <= _DISCORD_MAX_SNOWFLAKE else None
+
+
+def _discord_reply_context(
+    reference: Any,
+    client: Any,
+) -> Tuple[Optional[str], Optional[str], Optional[str], Optional[str], bool]:
+    """Normalize an exact default Discord reply without trusting its shape."""
+    if _discord_attr(reference, "type") is not discord.MessageReferenceType.default:
+        return None, None, None, None, False
+
+    reply_to_message_id = _discord_snowflake_string(
+        _discord_attr(reference, "message_id")
+    )
+    resolved = _discord_attr(reference, "resolved")
+    if resolved is None:
+        return reply_to_message_id, None, None, None, False
+
+    content = _discord_attr(resolved, "content")
+    reply_to_text = content if isinstance(content, str) and content else None
+    author = _discord_attr(resolved, "author")
+    reply_to_author_id = _discord_snowflake_string(_discord_attr(author, "id"))
+
+    reply_to_author_name = None
+    for attribute in ("display_name", "name"):
+        value = _discord_attr(author, attribute)
+        try:
+            value = str(value) if value is not None else None
+        except Exception:
+            value = None
+        if value:
+            reply_to_author_name = value
+            break
+
+    client_user_id = _discord_snowflake_string(
+        _discord_attr(_discord_attr(client, "user"), "id")
+    )
+    reply_to_is_own_message = (
+        reply_to_author_id is not None
+        and client_user_id is not None
+        and reply_to_author_id == client_user_id
+    )
+    return (
+        reply_to_message_id,
+        reply_to_text,
+        reply_to_author_id,
+        reply_to_author_name,
+        reply_to_is_own_message,
+    )
+
+
