+def _discord_batch_boundary(event: Any, reference: Any) -> Tuple[bool, bool]:
+    """Return privacy-safe message-boundary booleans for text batching."""
+    reference_present = reference is not None
+    try:
+        text = event.text
+    except Exception:
+        text = None
+    reserved_exact_ok = (
+        type(text) is str and text.strip(" \t\r\n") == "OK"
+    )
+    return reference_present, reserved_exact_ok
+
