+@method("skin.refresh")
+def _refresh_macos_skin(rid, params: dict) -> dict:
+    # Deliberately NOT in _LONG_HANDLERS: refresh and config.set must serialize.
+    from hermes_cli.macos_skin import live_policy, effective_skin_changed
+    from hermes_constants import get_hermes_home
+
+    before = resolve_skin()
+    policy = live_policy((_load_cfg().get("display") or {}).get("skin", "default"), get_hermes_home())
+    if policy is not None:
+        policy.refresh()
+    payload = resolve_skin()
+    if effective_skin_changed(before, payload):
+        _emit("skin.changed", "", payload)
+    return _ok(rid, payload)
