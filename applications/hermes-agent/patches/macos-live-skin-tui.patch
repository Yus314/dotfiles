+import type { GatewayClient } from '../gatewayClient.js'
+import type { GatewayEvent, GatewaySkin } from '../gatewayTypes.js'
+import { asRpcResult } from '../lib/rpc.js'
+
+import { applySkin } from './createGatewayEventHandler.js'
+
+// Owned by the event-subscription effect, not render. A fresh effect may attach
+// after gateway.ready was drained, so probe once if already connected.
+export function startSkinSync(
+  gw: Pick<GatewayClient, 'connected' | 'request' | 'on' | 'off'>,
+  apply: (skin: GatewaySkin) => void = applySkin
+): () => void {
+  let stopped = false
+  let inFlight = false
+  let revision = 0
+  let mode: GatewaySkin['mode']
+  let timer: ReturnType<typeof setInterval> | undefined
+
+  const clear = () => {
+    if (timer !== undefined) clearInterval(timer)
+    timer = undefined
+  }
+  const schedule = () => {
+    clear()
+    if (!stopped && mode === 'auto') timer = setInterval(() => void refresh(), 3000)
+  }
+  const refresh = async () => {
+    if (stopped || inFlight || !gw.connected) return
+    inFlight = true
+    const at = revision
+    try {
+      const skin = asRpcResult<GatewaySkin>(await gw.request<GatewaySkin>('skin.refresh'))
+      // A manual choice / reconnect / unmount supersedes the old response.
+      if (stopped || at !== revision || !gw.connected || !skin) return
+      mode = skin.mode
+      apply(skin)
+      schedule()
+    } catch {
+      // Background appearance detection must never add transcript noise.
+    } finally {
+      inFlight = false
+    }
+  }
+  const onEvent = (event: GatewayEvent) => {
+    if (event.type !== 'gateway.ready' && event.type !== 'skin.changed') return
+    const skin = event.type === 'gateway.ready' ? event.payload?.skin : event.payload
+    revision++
+    mode = skin?.mode
+    schedule()
+  }
+  const onExit = () => {
+    revision++
+    mode = undefined
+    clear()
+  }
+  gw.on('event', onEvent)
+  gw.on('exit', onExit)
+  if (gw.connected) void refresh()
+
+  return () => {
+    stopped = true
+    revision++
+    clear()
+    gw.off('event', onEvent)
+    gw.off('exit', onExit)
+  }
+}
