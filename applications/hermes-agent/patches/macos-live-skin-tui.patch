+import { EventEmitter } from 'node:events'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { startSkinSync } from '../app/skinSync.js'
+import type { GatewaySkin } from '../gatewayTypes.js'
+import { withSkinAutoCompletion } from '../hooks/useCompletion.js'
+
+class FakeGateway extends EventEmitter {
+  connected = false
+  request = vi.fn(async (): Promise<GatewaySkin> => ({
+    mode: 'auto',
+    appearance: 'dark',
+    source: 'macos'
+  }))
+}
+
+const deferred = () => {
+  let resolve!: (skin: GatewaySkin) => void
+  const promise = new Promise<GatewaySkin>(r => {
+    resolve = r
+  })
+  return { promise, resolve }
+}
+
+// Structural fake only: production code uses GatewayClient's live transport getter.
+const start = (gw: FakeGateway, apply = vi.fn()) => startSkinSync(gw as any, apply)
+const ready = (gw: FakeGateway, mode = 'auto') => {
+  gw.connected = true
+  gw.emit('event', {
+    type: 'gateway.ready',
+    payload: { skin: { mode, source: 'macos' } }
+  })
+}
+
+describe('skin refresh lifecycle', () => {
+  beforeEach(() => vi.useFakeTimers())
+  afterEach(() => vi.useRealTimers())
+
+  it('waits for ready; polls every 3s, never overlaps, skips disconnected', async () => {
+    const gw = new FakeGateway()
+    const pending = deferred()
+    gw.request.mockImplementationOnce(() => pending.promise)
+    const apply = vi.fn()
+    const stop = start(gw, apply)
+    await vi.advanceTimersByTimeAsync(9000)
+    expect(gw.request).not.toHaveBeenCalled()
+    ready(gw)
+    await vi.advanceTimersByTimeAsync(2999)
+    expect(gw.request).not.toHaveBeenCalled()
+    await vi.advanceTimersByTimeAsync(1)
+    expect(gw.request).toHaveBeenCalledExactlyOnceWith('skin.refresh')
+    await vi.advanceTimersByTimeAsync(9000)
+    expect(gw.request).toHaveBeenCalledTimes(1)
+    pending.resolve({ mode: 'auto', appearance: 'light', source: 'macos' })
+    await vi.advanceTimersByTimeAsync(0)
+    expect(apply).toHaveBeenCalledWith({
+      mode: 'auto',
+      appearance: 'light',
+      source: 'macos'
+    })
+    gw.connected = false
+    await vi.advanceTimersByTimeAsync(6000)
+    expect(gw.request).toHaveBeenCalledTimes(1)
+    gw.connected = true
+    await vi.advanceTimersByTimeAsync(3000)
+    expect(gw.request).toHaveBeenCalledTimes(2)
+    stop()
+    expect(vi.getTimerCount()).toBe(0)
+    expect(gw.listenerCount('event')).toBe(0)
+    expect(gw.listenerCount('exit')).toBe(0)
+  })
+
+  it('is quiet on errors, retries, stops on exit and resumes on ready', async () => {
+    const gw = new FakeGateway()
+    gw.request.mockRejectedValueOnce(new Error('offline'))
+    const apply = vi.fn()
+    const stop = start(gw, apply)
+    ready(gw)
+    await vi.advanceTimersByTimeAsync(6000)
+    expect(gw.request).toHaveBeenCalledTimes(2)
+    expect(apply).toHaveBeenCalledTimes(1)
+    gw.emit('exit')
+    expect(vi.getTimerCount()).toBe(0)
+    ready(gw)
+    await vi.advanceTimersByTimeAsync(3000)
+    expect(gw.request).toHaveBeenCalledTimes(3)
+    stop()
+  })
+
+  it.each(['manual', 'disabled'])(
+    'stops polls in %s mode, rejects stale refresh and can return to auto',
+    async mode => {
+      const gw = new FakeGateway()
+      const pending = deferred()
+      gw.request.mockImplementationOnce(() => pending.promise)
+      const apply = vi.fn()
+      const stop = start(gw, apply)
+      ready(gw)
+      await vi.advanceTimersByTimeAsync(3000)
+      gw.emit('event', {
+        type: 'skin.changed',
+        payload: { mode, source: 'macos' }
+      })
+      pending.resolve({ mode: 'auto', appearance: 'light' })
+      await vi.advanceTimersByTimeAsync(9000)
+      expect(apply).not.toHaveBeenCalled()
+      expect(gw.request).toHaveBeenCalledTimes(1)
+      expect(vi.getTimerCount()).toBe(0)
+      gw.emit('event', {
+        type: 'skin.changed',
+        payload: { mode: 'auto', source: 'macos' }
+      })
+      await vi.advanceTimersByTimeAsync(3000)
+      expect(gw.request).toHaveBeenCalledTimes(2)
+      stop()
+    }
+  )
+
+  it('disabled scope never starts a timer; late mount probes once; cleanup ignores pending results', async () => {
+    const gw = new FakeGateway()
+    let stop = start(gw)
+    ready(gw, 'disabled')
+    await vi.advanceTimersByTimeAsync(9000)
+    expect(gw.request).not.toHaveBeenCalled()
+    expect(vi.getTimerCount()).toBe(0)
+    stop()
+    gw.request.mockResolvedValueOnce({ mode: 'disabled', source: 'macos' })
+    stop = start(gw)
+    await vi.advanceTimersByTimeAsync(9000)
+    expect(gw.request).toHaveBeenCalledTimes(1)
+    expect(vi.getTimerCount()).toBe(0)
+    stop()
+    const pending = deferred()
+    gw.request.mockImplementationOnce(() => pending.promise)
+    const apply = vi.fn()
+    stop = start(gw, apply)
+    stop()
+    pending.resolve({ mode: 'auto', appearance: 'light' })
+    await vi.advanceTimersByTimeAsync(9000)
+    expect(apply).not.toHaveBeenCalled()
+    expect(vi.getTimerCount()).toBe(0)
+    expect(gw.listenerCount('event')).toBe(0)
+  })
+})
+
+it('completes /skin auto for either server replacement offset without duplicates', () => {
+  expect(withSkinAutoCompletion('/skin a', [], 1)[0].text).toBe('skin auto')
+  expect(withSkinAutoCompletion('/skin a', [], 6)[0].text).toBe('auto')
+  const items = [{ text: 'auto', display: 'auto' }]
+  expect(withSkinAutoCompletion('/skin ', items, 6)).toBe(items)
+  expect(withSkinAutoCompletion('/skin x', [])).toEqual([])
+  expect(withSkinAutoCompletion('/skin auto extra', [])).toEqual([])
+})
