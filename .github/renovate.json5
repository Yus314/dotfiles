{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: [
		'config:best-practices',
	],
	timezone: 'Asia/Tokyo',
	schedule: [
		'before 3:00am',
	],
	lockFileMaintenance: {
		enabled: true,
		schedule: [
			'before 3:00am',
		],
	},
	automerge: false,
	automergeStrategy: 'rebase',
	ignoreDeps: [
		'emacs-overlay-31',
		'nixpkgs-emacs',
	],
	packageRules: [
		{
			matchUpdateTypes: [
				'digest',
				'pin',
				'pinDigest',
				'patch',
				'minor',
			],
			automerge: true,
		},
		{
			matchManagers: [
				'terraform',
			],
			automerge: false,
		},
	],
	nix: {
		enabled: true,
	},
}
